# Скопируйте в .env и заполните. Файл .env в git не коммитится.
# Значения без кавычек не должны содержать # — всё после # считается комментарием.

NODE_ENV=production
PORT=5000
# 127.0.0.1 — если перед сервером стоит прокси на этой же машине (cloudflared / Caddy):
# тогда порт 5000 снаружи недоступен. 0.0.0.0 — доступ по IP из локальной сети.
HOST=127.0.0.1

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=mesnation
DB_PASSWORD=
DB_NAME=mesnation_db

# Обязательно! Минимум 32 символа, только буквы и цифры (без #).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Смена ключа разлогинит всех пользователей.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Собранная веб-версия (cd web && npm run build). Сайт и API — с одного адреса.
WEB_DIST_DIR=../web/dist

# Кому доверять X-Forwarded-For: loopback — прокси на этой же машине (по умолчанию).
TRUST_PROXY=loopback

# Нужен, только если сайт открывается с ДРУГОГО домена, чем API (обычно не нужен).
CORS_ORIGINS=

UPLOADS_DIR=uploads
OLLAMA_HOST=http://localhost:11434
LOG_LEVEL=info

# Push-уведомления (Firebase): JSON сервисного аккаунта или путь к файлу. Пусто — push выключены.
FIREBASE_SERVICE_ACCOUNT=
