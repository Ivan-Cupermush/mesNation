# Скопируйте в .env и заполните. Файл .env в git не коммитится.

NODE_ENV=production
PORT=5000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=mesnation
DB_PASSWORD=
DB_NAME=mesnation_db

# Обязательно! Минимум 32 символа. Сгенерировать: openssl rand -hex 48
# Смена ключа разлогинит всех пользователей.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Разрешённые origin для браузера через запятую (веб-версия на другом домене).
# Мобильному приложению CORS не нужен.
CORS_ORIGINS=https://web.offixcrm.ru

UPLOADS_DIR=uploads
OLLAMA_HOST=http://localhost:11434
LOG_LEVEL=info
