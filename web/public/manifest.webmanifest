{
  "name": "Offix",
  "short_name": "Offix",
  "description": "Чаты, задачи, заметки и KPI компании",
  "lang": "ru",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#F5F6F3",
  "theme_color": "#1F7A52",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/share",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "shortcuts": [
    { "name": "Чаты", "url": "/chats", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Задачи", "url": "/tasks", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Заметки", "url": "/notes", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
